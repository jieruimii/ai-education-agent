# Copy this file to .env and paste a newly rotated Meta Model API key.
# Never commit the real .env file.
MODEL_API_KEY=replace_with_your_rotated_key
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
META_MAX_COMPLETION_TOKENS=2048

# Use "mock" to force local responses even when a key exists; use "auto" for Meta.
AI_AGENT_MODE=auto
