# Copy this file to .env and paste a newly rotated Meta Llama API key.
# Never commit the real .env file.
LLAMA_API_KEY=replace_with_your_rotated_key
LLAMA_MODEL=Llama-4-Maverick-17B-128E-Instruct-FP8
LLAMA_MAX_COMPLETION_TOKENS=320

# Use "mock" to force local responses even when a key exists; use "auto" for Meta.
AI_AGENT_MODE=auto
