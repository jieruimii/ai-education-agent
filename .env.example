# Copy this file to .env and paste a newly rotated Meta Model API key.
# Never commit the real .env file.
MODEL_API_KEY=replace_with_your_rotated_key
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-wonder-1.0
META_MAX_COMPLETION_TOKENS=2048

# Use "mock" for fully local responses, "meta" for explicit live mode, or
# "auto" to use Meta only when a non-placeholder key is present.
AI_AGENT_MODE=mock

# In Meta Mode, search a bounded public encyclopedia source before drafting.
# Set false for a fully provider-only request.
ENABLE_WEB_RESEARCH=true
